---
import '../styles/main.css';

export interface Props {
  title?: string;
}
const { title = 'Skills Registry' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Nava Skills Registry</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <div class="flex h-screen overflow-hidden">

      <!-- Sidebar -->
      <aside class="w-56 flex-shrink-0 flex flex-col bg-white border-r border-gray-200 overflow-y-auto">

        <!-- Logo -->
        <div class="px-4 py-4 border-b border-gray-200">
          <a href="/" class="flex items-center gap-2 no-underline text-gray-900 hover:text-plum-700">
            <span class="text-plum-600 font-bold text-base leading-none">✦</span>
            <span class="font-semibold text-sm">Nava Skills</span>
          </a>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-2 py-3 space-y-4">
          <div>
            <p class="px-2 mb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Navigation</p>
            <ul class="space-y-0.5 list-none p-0 m-0">
              <li>
                <a href="/" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors" id="nav-marketplace">
                  <span class="text-gray-400 text-xs">⊞</span> Marketplace
                </a>
              </li>
              <li>
                <a href="/my-skills" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors" id="nav-my-skills">
                  <span class="text-gray-400 text-xs">◈</span> My Skills
                </a>
              </li>
              <li>
                <a href="/whats-new" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors" id="nav-whats-new">
                  <span class="text-gray-400 text-xs">★</span> What's New
                </a>
              </li>
              <li>
                <a href="/contribute" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors" id="nav-contribute">
                  <span class="text-gray-400 text-xs">+</span> Add a Skill
                </a>
              </li>
            </ul>
          </div>

          <!-- Resources -->
          <div>
            <p class="px-2 mb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Resources</p>
            <ul class="space-y-0.5 list-none p-0 m-0">
              <li>
                <a href="https://navasage.atlassian.net/wiki/spaces/NH/pages/3137536013/FAQ+Claude+Skills" target="_blank" rel="noopener" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors">
                  <span class="text-gray-400 text-xs">?</span> FAQ: Claude Skills
                </a>
              </li>
              <li>
                <a href="https://docs.google.com/document/d/11oOUFyQi5XF9_XGHpJwhU3SLWTULqgW-rFPqbLcBlRc/edit?tab=t.0#heading=h.5t6aswo651ah" target="_blank" rel="noopener" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors">
                  <span class="text-gray-400 text-xs">◎</span> Community of Practice
                </a>
              </li>
              <li>
                <a href="https://navasage.atlassian.net/wiki/spaces/NH/pages/3140136126/AI+Office+Hours" target="_blank" rel="noopener" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 rounded hover:bg-gray-100 hover:text-gray-900 no-underline transition-colors">
                  <span class="text-gray-400 text-xs">◷</span> AI Office Hours
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <!-- User footer -->
        <div class="px-3 py-3 border-t border-gray-200">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-plum-100 text-plum-700 text-xs font-semibold flex items-center justify-center flex-shrink-0 overflow-hidden" id="user-avatar">?</span>
            <span class="text-xs text-gray-500 truncate flex-1 min-w-0" id="user-email"></span>
            <a href="/auth/logout" title="Sign out" class="flex-shrink-0 text-gray-400 hover:text-gray-600 transition-colors no-underline" aria-label="Sign out">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- Main -->
      <main class="flex-1 overflow-y-auto">
        <div class="max-w-5xl mx-auto px-8 py-8">
          <slot />
        </div>
      </main>
    </div>

    <script>
      (function () {
        function getDisplayUser() {
          const cookie = document.cookie
            .split('; ')
            .find(r => r.startsWith('__user='));
          if (!cookie) return null;
          try {
            const b64 = cookie.substring('__user='.length).replace(/-/g, '+').replace(/_/g, '/');
            return JSON.parse(atob(b64));
          } catch {
            return null;
          }
        }

        const user = getDisplayUser();
        const avatarEl = document.getElementById('user-avatar');
        const emailEl = document.getElementById('user-email');
        if (user && avatarEl && emailEl) {
          if (user.picture) {
            avatarEl.innerHTML = '<img src="' + user.picture + '" alt="" class="w-full h-full object-cover">';
          } else {
            const initials = (user.name || user.email || '?')
              .split(' ')
              .map((n: string) => n[0])
              .join('')
              .slice(0, 2)
              .toUpperCase();
            avatarEl.textContent = initials;
          }
          emailEl.textContent = user.name || user.email || '';
        }

        // Highlight active nav link
        const path = window.location.pathname;
        const navMap: Record<string, string> = {
          '/': 'nav-marketplace',
          '/my-skills': 'nav-my-skills',
          '/whats-new': 'nav-whats-new',
          '/contribute': 'nav-contribute',
        };
        const activeId = navMap[path];
        if (activeId) {
          const el = document.getElementById(activeId);
          if (el) {
            el.classList.add('bg-plum-50', 'text-plum-700', 'font-medium');
            el.classList.remove('text-gray-600');
          }
        }

      })();
    </script>
  </body>
</html>
