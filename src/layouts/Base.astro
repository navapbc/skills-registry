---
import '../styles/main.css';
import Sidebar from '../components/Sidebar.astro';

export interface Props {
  title?: string;
  description?: string;
}
const { title = 'Skills Registry', description = 'Browse, install, and share reusable AI skills across Nava.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Nava Skills Registry</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <!-- Skip link: lets keyboard users jump past sidebar -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-plum-600 focus:text-white focus:rounded focus:text-sm focus:font-medium">Skip to main content</a>
    <div class="flex h-screen overflow-hidden">
      <Sidebar />
      <main id="main-content" class="flex-1 overflow-y-auto" tabindex="-1">
        <div class="max-w-5xl mx-auto px-8 py-8">
          <slot />
        </div>
      </main>
    </div>

    <script>
      (function () {
        function getDisplayUser() {
          const cookie = document.cookie.split('; ').find(r => r.startsWith('__user='));
          if (!cookie) return null;
          try {
            const b64 = cookie.substring('__user='.length).replace(/-/g, '+').replace(/_/g, '/');
            return JSON.parse(atob(b64));
          } catch {
            return null;
          }
        }

        const user = getDisplayUser();
        const avatarEl = document.getElementById('user-avatar');
        const emailEl = document.getElementById('user-email');
        if (user && avatarEl && emailEl) {
          if (user.picture) {
            avatarEl.innerHTML = '<img src="' + user.picture + '" alt="" class="w-full h-full object-cover">';
          } else {
            const initials = (user.name || user.email || '?')
              .split(' ')
              .map((n: string) => n[0])
              .join('')
              .slice(0, 2)
              .toUpperCase();
            avatarEl.textContent = initials;
          }
          emailEl.textContent = user.name || user.email || '';
        }

        const path = window.location.pathname;
        const navMap: Record<string, string> = {
          '/': 'nav-marketplace',
          '/my-skills': 'nav-my-skills',
          '/whats-new': 'nav-whats-new',
          '/contribute': 'nav-contribute',
        };
        const activeId = navMap[path];
        if (activeId) {
          const el = document.getElementById(activeId);
          if (el) {
            el.classList.add('bg-plum-50', 'text-plum-700', 'font-medium');
            el.setAttribute('aria-current', 'page');
            el.classList.remove('text-gray-600');
          }
        }
      })();
    </script>
  </body>
</html>
