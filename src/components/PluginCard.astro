---
export interface Props {
  plugin: {
    slug: string;
    name: string;
    description: string;
    author: string;
    skill_count: number;
    agent_count: number;
  };
}
const { plugin } = Astro.props;
const total = plugin.skill_count + plugin.agent_count;
const initial = plugin.author.slice(0, 1).toUpperCase();
---

<a href={`/plugins/${plugin.slug}`} class="flex flex-col gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:shadow-md hover:border-gray-300 transition-all no-underline text-gray-900 group">
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-gray-400 text-sm flex-shrink-0">▤</span>
      <span class="font-semibold text-sm text-gray-900 truncate">{plugin.name}</span>
    </div>
    <span class="text-xs text-gray-400 flex-shrink-0 whitespace-nowrap">⊙ {total} {total === 1 ? 'skill' : 'skills'}</span>
  </div>

  {plugin.description && (
    <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 m-0">{plugin.description}</p>
  )}

  <div class="flex items-center justify-between mt-auto pt-1">
    <span
      class="w-6 h-6 rounded-full bg-plum-100 text-plum-700 text-xs font-semibold flex items-center justify-center"
      aria-label={plugin.author}
    >
      {initial}
    </span>
    <span class="text-xs font-medium text-gray-400 tracking-wide uppercase">Plugin</span>
  </div>
</a>
