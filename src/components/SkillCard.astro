---
export interface Props {
  skill: {
    slug: string;
    name: string;
    description: string;
    plugin: string;
    author: string;
    type: string;
    sensitive_data: boolean;
    compatibility: string[];
    last_updated: string;
  };
  showPlugin?: boolean;
}
const { skill, showPlugin = true } = Astro.props;
const initial = skill.author.slice(0, 1).toUpperCase();
const preview = skill.description.length > 110
  ? skill.description.slice(0, 110) + '...'
  : skill.description;
---

<a
  href={`/skills/${skill.slug}`}
  class="flex flex-col gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:shadow-md hover:border-gray-300 transition-all no-underline text-gray-900"
  data-name={skill.name}
  data-description={skill.description}
  data-plugin={skill.plugin}
  data-compatibility={skill.compatibility.join(',')}
  data-sensitive={String(skill.sensitive_data)}
  data-type={skill.type}
  data-updated={skill.last_updated}
>
  <div class="flex items-start justify-between gap-2 flex-wrap">
    <span class="font-semibold text-sm text-gray-900">{skill.name}</span>
    <div class="flex items-center gap-1 flex-wrap">
      {showPlugin && (
        <span class="px-1.5 py-0.5 text-xs font-medium bg-plum-50 text-plum-700 rounded">
          {skill.plugin}
        </span>
      )}
      {skill.type === 'agent' && (
        <span class="px-1.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded">
          agent
        </span>
      )}
      {skill.sensitive_data && (
        <span class="px-1.5 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 rounded" title="Contains sensitive data">
          ⚠
        </span>
      )}
    </div>
  </div>

  <p class="text-xs text-gray-500 leading-relaxed m-0 flex-1">{preview}</p>

  <div class="flex items-center justify-between mt-auto pt-1">
    <span
      class="w-5 h-5 rounded-full bg-plum-100 text-plum-700 text-xs font-semibold flex items-center justify-center flex-shrink-0"
      aria-label={skill.author}
    >
      {initial}
    </span>
    <span class="text-xs text-gray-400 truncate ml-2">
      {skill.compatibility.slice(0, 2).join(', ')}
      {skill.compatibility.length > 2 && ` +${skill.compatibility.length - 2}`}
    </span>
  </div>
</a>
