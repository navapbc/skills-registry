---
export interface Props {
  skill: {
    slug: string;
    name: string;
    description: string;
    plugin: string;
    author: string;
    committer?: { login: string | null; name: string; avatar_url: string | null } | null;
    type: string;
    sensitive_data: boolean;
    compatibility: string[];
    last_updated: string;
  };
  showPlugin?: boolean;
}
const { skill, showPlugin = true } = Astro.props;
const committer = skill.committer;
const displayName = committer?.login || committer?.name || skill.author;
const avatarUrl = committer?.avatar_url || null;
const initial = displayName.slice(0, 1).toUpperCase();
const githubUrl = committer?.login ? `https://github.com/${committer.login}` : null;
const preview = skill.description.length > 110
  ? skill.description.slice(0, 110) + '...'
  : skill.description;
---

<div class="relative h-full">
  <!-- Favorite button — positioned top-right, outside the card link -->
  <button
    class="fav-btn absolute top-2 right-2 z-10 w-6 h-6 flex items-center justify-center text-gray-300 hover:text-amber-400 transition-colors rounded"
    data-slug={skill.slug}
    data-skill={JSON.stringify({ slug: skill.slug, name: skill.name, plugin: skill.plugin, type: skill.type, description: skill.description, compatibility: skill.compatibility })}
    aria-label="Add to favorites"
    aria-pressed="false"
    title="Favorite"
  >
    <span aria-hidden="true" class="fav-star text-base leading-none">☆</span>
  </button>

  <a
    href={`/skills/${skill.slug}`}
    class="h-full flex flex-col gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:shadow-md hover:border-gray-300 transition-all no-underline text-gray-900"
    data-name={skill.name}
    data-description={skill.description}
    data-plugin={skill.plugin}
    data-compatibility={skill.compatibility.join(',')}
    data-sensitive={String(skill.sensitive_data)}
    data-type={skill.type}
    data-updated={skill.last_updated}
  >
    <div class="flex items-start justify-between gap-2 flex-wrap pr-5">
      <span class="font-semibold text-sm text-gray-900">{skill.name}</span>
      <div class="flex items-center gap-1 flex-wrap">
        {showPlugin && (
          <span class="px-1.5 py-0.5 text-xs font-medium bg-plum-50 text-plum-700 rounded">
            {skill.plugin}
          </span>
        )}
        {skill.type === 'agent' && (
          <span class="px-1.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded">
            agent
          </span>
        )}
        {skill.sensitive_data && (
          <span class="px-1.5 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 rounded" title="Contains sensitive data">
            ⚠
          </span>
        )}
      </div>
    </div>

    <p class="text-xs text-gray-500 leading-relaxed m-0 flex-1">{preview}</p>

    <div class="flex items-center justify-between mt-auto pt-1">
      <span
        class="flex items-center gap-1.5 cursor-pointer"
        data-github-url={githubUrl || ''}
        title={githubUrl ? `@${displayName}` : displayName}
      >
        {avatarUrl ? (
          <img src={avatarUrl} alt={displayName} class="w-5 h-5 rounded-full flex-shrink-0" />
        ) : (
          <span class="w-5 h-5 rounded-full bg-plum-100 text-plum-700 text-xs font-semibold flex items-center justify-center flex-shrink-0">
            {initial}
          </span>
        )}
        <span class="text-xs text-gray-400">{displayName}</span>
      </span>
      <span class="text-xs text-gray-400 truncate ml-2">
        {skill.compatibility.slice(0, 2).join(', ')}
        {skill.compatibility.length > 2 && ` +${skill.compatibility.length - 2}`}
      </span>
    </div>
  </a>
</div>

<script>
  import { isFavorited, toggleFavorite } from '../lib/favorites.mjs';

  // Wire up github link clicks
  document.querySelectorAll('[data-github-url]').forEach(el => {
    el.addEventListener('click', e => {
      const url = (el as HTMLElement).dataset.githubUrl;
      if (url) {
        e.preventDefault();
        e.stopPropagation();
        window.open(url, '_blank', 'noopener');
      }
    });
  });

  // Wire up favorite buttons
  document.querySelectorAll<HTMLButtonElement>('.fav-btn').forEach(btn => {
    const slug = btn.dataset.slug!;
    const star = btn.querySelector('.fav-star')!;

    function setFavState(fav: boolean) {
      btn.setAttribute('aria-pressed', String(fav));
      btn.setAttribute('aria-label', fav ? 'Remove from favorites' : 'Add to favorites');
      btn.setAttribute('title', fav ? 'Remove from favorites' : 'Favorite');
      btn.classList.toggle('text-amber-400', fav);
      btn.classList.toggle('text-gray-300', !fav);
      star.textContent = fav ? '★' : '☆';
    }

    // Set initial state from localStorage
    setFavState(isFavorited(slug));

    btn.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      let skill: any;
      try { skill = JSON.parse(btn.dataset.skill || '{}'); } catch { skill = { slug }; }
      const nowFav = toggleFavorite(skill);
      setFavState(nowFav);
    });
  });
</script>
