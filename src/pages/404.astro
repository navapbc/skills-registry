---
import Base from '../layouts/Base.astro';
---

<Base title="Not Found" description="Page not found — Nava Skills Registry.">
  <div class="flex flex-col items-start gap-4 py-16">
    <h1 class="text-2xl font-bold text-gray-900 m-0">404 — Not Found</h1>
    <p class="text-sm text-gray-500 m-0">This page doesn't exist.</p>
    <a href="/" class="px-4 py-2 text-sm font-medium bg-plum-600 text-white rounded hover:bg-plum-700 no-underline transition-colors">
      Back to Marketplace
    </a>
  </div>
</Base>
