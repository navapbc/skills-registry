---
import Base from '../layouts/Base.astro';
---

<Base title="My Skills" description="Skills and agents you have installed or bookmarked.">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 m-0">My Skills</h1>
      <p class="text-sm text-gray-500 mt-1 m-0" id="skills-count">Skills you've installed</p>
    </div>
    <button
      id="clear-all"
      class="hidden px-3 py-1.5 text-sm text-gray-500 border border-gray-200 rounded hover:border-gray-300 hover:text-gray-700 bg-white cursor-pointer transition-colors"
    >
      Clear all
    </button>
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden">
    <div class="flex flex-col items-center justify-center py-20 px-8 border-2 border-dashed border-gray-200 rounded-xl bg-white text-center">
      <span class="text-3xl text-plum-300 mb-4">✦</span>
      <p class="font-semibold text-gray-800 mb-2 m-0">No skills installed yet</p>
      <p class="text-sm text-gray-500 mb-6 m-0 max-w-xs">Copy a skill's install command and it'll appear here for quick access.</p>
      <a href="/" class="px-4 py-2 text-sm font-medium bg-plum-600 text-white rounded hover:bg-plum-700 no-underline transition-colors">
        Browse Marketplace →
      </a>
    </div>
  </div>

  <!-- Skills grid -->
  <div id="skills-grid" class="grid grid-cols-3 gap-3"></div>
</Base>

<script>
  const STORAGE_KEY = 'nava_installed_skills';

  interface InstalledSkill {
    slug: string;
    name: string;
    plugin: string;
    description: string;
    compatibility: string[];
    type: string;
    installedAt: number;
    installCommand?: string;
  }

  function getInstalled(): InstalledSkill[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveInstalled(skills: InstalledSkill[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(skills));
  }

  function removeSkill(slug: string) {
    const skills = getInstalled().filter(s => s.slug !== slug);
    saveInstalled(skills);
    render();
  }

  function timeAgo(ts: number): string {
    const diff = Date.now() - ts;
    const days = Math.floor(diff / 86400000);
    if (days === 0) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 7) return `${days} days ago`;
    if (days < 30) return `${Math.floor(days / 7)} week${Math.floor(days / 7) > 1 ? 's' : ''} ago`;
    return `${Math.floor(days / 30)} month${Math.floor(days / 30) > 1 ? 's' : ''} ago`;
  }

  function render() {
    const skills = getInstalled();
    const grid = document.getElementById('skills-grid')!;
    const emptyState = document.getElementById('empty-state')!;
    const clearBtn = document.getElementById('clear-all')!;
    const countEl = document.getElementById('skills-count')!;

    if (skills.length === 0) {
      emptyState.classList.remove('hidden');
      grid.classList.add('hidden');
      clearBtn.classList.add('hidden');
      countEl.textContent = 'Skills you\'ve installed';
      return;
    }

    emptyState.classList.add('hidden');
    grid.classList.remove('hidden');
    clearBtn.classList.remove('hidden');
    countEl.textContent = `${skills.length} skill${skills.length === 1 ? '' : 's'} installed`;

    grid.innerHTML = skills.map(skill => {
      const initial = skill.name.slice(0, 1).toUpperCase();
      const typeTag = skill.type === 'agent'
        ? `<span class="px-1.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded">agent</span>`
        : `<span class="px-1.5 py-0.5 text-xs font-medium bg-plum-50 text-plum-700 rounded">${skill.plugin}</span>`;
      const preview = skill.description.length > 100
        ? skill.description.slice(0, 100) + '...'
        : skill.description;
      const cmd = skill.installCommand || '';

      return `
        <div class="flex flex-col gap-3 p-4 bg-white border border-gray-200 rounded-lg">
          <div class="flex items-start justify-between gap-2">
            <a href="/skills/${skill.slug}" class="font-semibold text-sm text-gray-900 no-underline hover:text-plum-700">${skill.name}</a>
            ${typeTag}
          </div>
          <p class="text-xs text-gray-500 leading-relaxed m-0 flex-1">${preview}</p>
          <div class="flex items-center justify-between mt-auto pt-1 gap-2">
            <span class="text-xs text-gray-400">Installed ${timeAgo(skill.installedAt)}</span>
            <div class="flex items-center gap-1.5">
              ${cmd ? `<button
                class="copy-btn px-2 py-1 text-xs font-medium text-plum-600 border border-plum-200 rounded hover:bg-plum-50 cursor-pointer transition-colors bg-white"
                data-copy="${cmd.replace(/"/g, '&quot;')}"
              >Copy</button>` : ''}
              <button
                class="remove-btn px-2 py-1 text-xs text-gray-400 border border-gray-200 rounded hover:border-gray-300 hover:text-gray-600 cursor-pointer transition-colors bg-white"
                data-slug="${skill.slug}"
              >✕</button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Copy buttons
    grid.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = (btn as HTMLElement).dataset.copy || '';
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });
      });
    });

    // Remove buttons
    grid.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.slug || '';
        removeSkill(slug);
      });
    });
  }

  // Clear all
  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (confirm('Remove all installed skills?')) {
      saveInstalled([]);
      render();
    }
  });

  render();
</script>
