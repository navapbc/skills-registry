---
import Base from '../layouts/Base.astro';
---

<Base title="My Skills" description="Skills and agents you have installed or bookmarked.">
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 m-0">My Skills</h1>
      <p class="text-sm text-gray-500 mt-1 m-0" id="skills-count"></p>
    </div>
    <button
      id="clear-all"
      class="hidden px-3 py-1.5 text-sm text-gray-500 border border-gray-200 rounded hover:border-gray-300 hover:text-gray-700 bg-white cursor-pointer transition-colors"
    >
      Clear all
    </button>
  </div>

  <!-- Tab switcher -->
  <div class="flex items-center gap-0 border-b border-gray-200 mb-6">
    <button
      id="tab-btn-favorites"
      class="px-4 py-2 text-sm font-medium border-b-2 -mb-px bg-transparent cursor-pointer transition-colors text-plum-700 border-plum-600"
      data-tab="favorites"
    >Favorites</button>
    <button
      id="tab-btn-installed"
      class="px-4 py-2 text-sm font-medium border-b-2 border-transparent -mb-px bg-transparent cursor-pointer transition-colors text-gray-500 hover:text-gray-700"
      data-tab="installed"
    >Installed</button>
  </div>

  <!-- Favorites panel -->
  <div id="panel-favorites">
    <div id="favorites-empty-state" class="hidden">
      <div class="flex flex-col items-center justify-center py-20 px-8 border-2 border-dashed border-amber-200 rounded-xl bg-white text-center">
        <span class="text-3xl text-amber-300 mb-4">☆</span>
        <p class="font-semibold text-gray-800 mb-2 m-0">No favorites yet</p>
        <p class="text-sm text-gray-500 mb-6 m-0 max-w-xs">Star any skill or agent on its detail page and it'll appear here for quick access.</p>
        <a href="/" class="px-4 py-2 text-sm font-medium bg-plum-600 text-white rounded hover:bg-plum-700 no-underline transition-colors">
          Browse Marketplace →
        </a>
      </div>
    </div>
    <div id="favorites-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
  </div>

  <!-- Installed panel -->
  <div id="panel-installed" class="hidden">
    <!-- Empty state -->
    <div id="empty-state" class="hidden">
      <div class="flex flex-col items-center justify-center py-20 px-8 border-2 border-dashed border-gray-200 rounded-xl bg-white text-center">
        <span class="text-3xl text-plum-300 mb-4">✦</span>
        <p class="font-semibold text-gray-800 mb-2 m-0">No skills installed yet</p>
        <p class="text-sm text-gray-500 mb-6 m-0 max-w-xs">Copy a skill's install command and it'll appear here for quick access.</p>
        <a href="/" class="px-4 py-2 text-sm font-medium bg-plum-600 text-white rounded hover:bg-plum-700 no-underline transition-colors">
          Browse Marketplace →
        </a>
      </div>
    </div>

    <!-- Skills grid -->
    <div id="skills-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
  </div>
</Base>

<script>
  import { getFavorites, getInstalled, removeFavorite, removeInstalled, clearInstalled, initFromUser } from '../lib/favorites.mjs';
  import { fetchApi } from '../lib/api.mjs';
  import { renderFavoriteCard, renderInstalledCard } from '../lib/my-skills-render.mjs';
  import type { Skill, InstalledSkill } from '../lib/types';

  // Sync server-side favorites in the background; re-render if data changed
  fetchApi('/users/me').then(user => {
    if (initFromUser(user)) renderFavorites();
  }).catch(() => {});

  function removeSkill(slug: string) {
    removeInstalled(slug);
    renderInstalled();
  }

  function timeAgo(ts: number): string {
    const diff = Date.now() - ts;
    const days = Math.floor(diff / 86400000);
    if (days === 0) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 7) return `${days} days ago`;
    if (days < 30) return `${Math.floor(days / 7)} week${Math.floor(days / 7) > 1 ? 's' : ''} ago`;
    return `${Math.floor(days / 30)} month${Math.floor(days / 30) > 1 ? 's' : ''} ago`;
  }

  let activeTab: 'favorites' | 'installed' = 'favorites';

  function switchTab(tab: 'favorites' | 'installed') {
    activeTab = tab;
    const favPanel = document.getElementById('panel-favorites')!;
    const instPanel = document.getElementById('panel-installed')!;
    const favBtn = document.getElementById('tab-btn-favorites')!;
    const instBtn = document.getElementById('tab-btn-installed')!;
    const clearBtn = document.getElementById('clear-all')!;

    if (tab === 'favorites') {
      favPanel.classList.remove('hidden');
      instPanel.classList.add('hidden');
      favBtn.className = 'px-4 py-2 text-sm font-medium border-b-2 -mb-px bg-transparent cursor-pointer transition-colors text-plum-700 border-plum-600';
      instBtn.className = 'px-4 py-2 text-sm font-medium border-b-2 border-transparent -mb-px bg-transparent cursor-pointer transition-colors text-gray-500 hover:text-gray-700';
      renderFavorites();
      clearBtn.classList.add('hidden');
    } else {
      favPanel.classList.add('hidden');
      instPanel.classList.remove('hidden');
      instBtn.className = 'px-4 py-2 text-sm font-medium border-b-2 -mb-px bg-transparent cursor-pointer transition-colors text-plum-700 border-plum-600';
      favBtn.className = 'px-4 py-2 text-sm font-medium border-b-2 border-transparent -mb-px bg-transparent cursor-pointer transition-colors text-gray-500 hover:text-gray-700';
      renderInstalled();
    }
  }

  function renderFavorites() {
    const favs = getFavorites();
    const grid = document.getElementById('favorites-grid')!;
    const emptyState = document.getElementById('favorites-empty-state')!;
    const countEl = document.getElementById('skills-count')!;

    if (favs.length === 0) {
      emptyState.classList.remove('hidden');
      grid.classList.add('hidden');
      countEl.textContent = '';
      return;
    }

    emptyState.classList.add('hidden');
    grid.classList.remove('hidden');
    countEl.textContent = `${favs.length} favorite${favs.length === 1 ? '' : 's'}`;

    grid.innerHTML = favs.map((fav: Skill) => renderFavoriteCard(fav)).join('');

    grid.querySelectorAll('.unfav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.slug || '';
        removeFavorite(slug);
        renderFavorites();
      });
    });
  }

  function renderInstalled() {
    const skills = getInstalled();
    const grid = document.getElementById('skills-grid')!;
    const emptyState = document.getElementById('empty-state')!;
    const clearBtn = document.getElementById('clear-all')!;
    const countEl = document.getElementById('skills-count')!;

    if (skills.length === 0) {
      emptyState.classList.remove('hidden');
      grid.classList.add('hidden');
      clearBtn.classList.add('hidden');
      countEl.textContent = '';
      return;
    }

    emptyState.classList.add('hidden');
    grid.classList.remove('hidden');
    clearBtn.classList.remove('hidden');
    countEl.textContent = `${skills.length} skill${skills.length === 1 ? '' : 's'} installed`;

    grid.innerHTML = skills
      .map((skill: InstalledSkill) => renderInstalledCard(skill, timeAgo(skill.installedAt)))
      .join('');

    // Copy buttons
    grid.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = (btn as HTMLElement).dataset.copy || '';
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });
      });
    });

    // Remove buttons
    grid.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.slug || '';
        removeSkill(slug);
      });
    });
  }

  // Tab button event listeners
  document.getElementById('tab-btn-favorites')?.addEventListener('click', () => switchTab('favorites'));
  document.getElementById('tab-btn-installed')?.addEventListener('click', () => switchTab('installed'));

  // Clear all (installed tab only)
  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (confirm('Remove all installed skills?')) {
      clearInstalled();
      renderInstalled();
    }
  });

  // Initial render — default to favorites tab
  switchTab('favorites');
</script>
