---
import Base from '../../layouts/Base.astro';
import CommitterCard from '../../components/CommitterCard.astro';
import InstallCard from '../../components/InstallCard.astro';
import registryData from '../../../public/registry/index.json';

export function getStaticPaths() {
  return registryData.skills.map(skill => ({
    params: { slug: skill.slug },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const plugin = registryData.plugins.find(p => p.slug === skill.plugin);
const hasClaudeCode = skill.compatibility.includes('claude-code');
const hasClaudeChat = skill.compatibility.includes('claude-chat') || skill.compatibility.includes('claude-cowork');
const claudeCodeCommand = `claude mcp add ${skill.slug} --from-github ${skill.repo}`;
const committer = (skill as any).committer as { login: string | null; name: string; avatar_url: string | null } | null;
const displayName = committer?.login || committer?.name || skill.author;
const avatarUrl = committer?.avatar_url || null;
const initial = displayName.slice(0, 1).toUpperCase();
function formatDate(value: string | null | undefined) {
  if (!value) return null;
  const d = new Date(value);
  return isNaN(d.getTime()) ? null : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
const addedDate = formatDate(skill.last_updated);
---

<Base title={skill.name}>

  <!-- Back -->
  <a href={plugin ? `/plugins/${plugin.slug}` : '/'} class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 no-underline mb-5 transition-colors">
    ← Back to {plugin?.name ?? 'Skills'}
  </a>

  <!-- Skill header -->
  <div class="mb-8">
    <div class="flex items-center gap-2 flex-wrap mb-2">
      <h1 class="text-2xl font-bold text-gray-900 m-0">{skill.name}</h1>
      <span class="px-2 py-0.5 text-xs font-medium bg-plum-50 text-plum-700 rounded">{skill.plugin}</span>
      {skill.sensitive_data && (
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 rounded">⚠ sensitive data</span>
      )}
      {skill.type === 'agent' && (
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded">agent</span>
      )}
    </div>
    <div class="flex items-center gap-2 text-sm text-gray-400">
      {avatarUrl ? (
        <img src={avatarUrl} alt={displayName} class="w-6 h-6 rounded-full flex-shrink-0" />
      ) : (
        <span class="w-6 h-6 rounded-full bg-plum-100 text-plum-700 text-xs font-semibold flex items-center justify-center">
          {initial}
        </span>
      )}
      {addedDate && <><span class="text-gray-300">·</span><span>Added {addedDate}</span></>}
      <span class="text-gray-300">·</span>
      <a
        href={`https://github.com/${skill.repo}/blob/main/${skill.path}`}
        target="_blank"
        rel="noopener"
        class="text-plum-600 hover:text-plum-700 no-underline"
      >
        View on GitHub ↗
      </a>
    </div>
  </div>

  <!-- Skill metadata for client-side localStorage -->
  <div
    hidden
    data-skill-json={JSON.stringify({
      slug: skill.slug,
      name: skill.name,
      plugin: skill.plugin,
      description: skill.description,
      compatibility: skill.compatibility,
      type: skill.type,
    })}
  ></div>

  <!-- Two-column layout -->
  <div class="flex gap-8 items-start">

    <!-- Main content -->
    <div class="flex-1 min-w-0 space-y-8">

      <section>
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3">Description</h2>
        <p class="text-sm text-gray-600 leading-relaxed m-0">{skill.description}</p>
        {skill.compatibility.length > 0 && (
          <div class="flex items-center gap-2 flex-wrap mt-3">
            <span class="text-xs text-gray-400">Works with:</span>
            {skill.compatibility.map(c => (
              <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded">{c}</span>
            ))}
          </div>
        )}
      </section>

      {skill.type === 'agent' && skill.tools_used && skill.tools_used.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3">Composed Skills</h2>
          <ul class="list-none p-0 m-0 space-y-1">
            {(skill.tools_used as string[]).map(toolSlug => {
              const tool = registryData.skills.find(s => s.slug === toolSlug);
              return (
                <li class="text-sm">
                  {tool
                    ? <a href={`/skills/${toolSlug}`} class="text-plum-600 hover:text-plum-700 no-underline">{tool.name}</a>
                    : <span class="text-gray-600">{toolSlug}</span>
                  }
                </li>
              );
            })}
          </ul>
          {skill.human_in_loop && (
            <div class="mt-3 p-3 bg-amber-50 border border-amber-200 rounded text-xs text-amber-800">
              <strong>Human in the loop:</strong> {skill.human_in_loop}
            </div>
          )}
        </section>
      )}

      <section>
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3">SKILL.md</h2>
        <pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap leading-relaxed m-0"><code>{skill.content}</code></pre>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 space-y-4">

      {hasClaudeCode && <InstallCard platform="claude-code" command={claudeCodeCommand} />}
      {hasClaudeChat && <InstallCard platform="claude-chat" />}
      <CommitterCard committer={committer} author={skill.author} />

      <!-- Details -->
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Details</h3>
        <dl class="space-y-2 m-0">
          {addedDate && (
            <div class="flex justify-between gap-2">
              <dt class="text-xs text-gray-400">Added</dt>
              <dd class="text-xs text-gray-700 m-0">{addedDate}</dd>
            </div>
          )}
          <div class="flex justify-between gap-2">
            <dt class="text-xs text-gray-400">Repo</dt>
            <dd class="text-xs m-0">
              <a
                href={`https://github.com/${skill.repo}`}
                target="_blank"
                rel="noopener"
                class="text-plum-600 hover:text-plum-700 no-underline truncate block max-w-32"
                title={skill.repo}
              >
                {skill.repo}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</Base>

<script>
  const STORAGE_KEY = 'nava_installed_skills';

  function getInstalled() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch { return []; }
  }

  function saveToMySkills(cmd: string) {
    const el = document.querySelector('[data-skill-json]') as HTMLElement;
    if (!el) return;
    try {
      const skill = JSON.parse(el.dataset.skillJson || '{}');
      const installed = getInstalled();
      if (!installed.find((s: {slug: string}) => s.slug === skill.slug)) {
        installed.unshift({ ...skill, installedAt: Date.now(), installCommand: cmd });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(installed));
      }
    } catch {}
  }

  document.querySelectorAll('[data-copy]').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).dataset.copy || '';
      navigator.clipboard.writeText(text).then(() => {
        saveToMySkills(text);
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
    });
  });
</script>
