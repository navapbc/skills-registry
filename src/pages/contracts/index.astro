---
import Base from '../../layouts/Base.astro';

// One page serves both /contracts and /contracts/<id>, branching on the pathname —
// the same shape as src/pages/skills/index.astro. Two pages would duplicate the
// fetch, the loading state, and the not-found rendering.
//
// The detail path only resolves because functions/edge/auth-check.js.tpl rewrites
// /contracts/* to this shell. Without that entry the grid works and every detail
// URL serves the 404 page.
---
<Base title="Contract Explorer" description="AI-use posture and guidance for Nava contracts.">
  <div id="contracts-content">
    <div class="animate-pulse">
      <div class="h-4 bg-gray-100 rounded w-28 mb-5"></div>
      <div class="h-8 bg-gray-200 rounded w-2/3 mb-2"></div>
      <div class="h-4 bg-gray-100 rounded w-1/3 mb-6"></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
      </div>
    </div>
  </div>
</Base>

<script>
import { fetchApi } from '../../lib/api.mjs';
import { escapeHtml } from '../../lib/render.mjs';
import {
  indexPostures,
  postureShortName,
  filterContracts,
  countHiddenUnclassified,
  portfoliosOf,
  describePopulationNotice,
  renderContractGrid,
  renderContractDetail,
  renderUnclassifiedToggle,
  formatCapturedAt,
} from '../../lib/contracts-render.mjs';

const container = document.getElementById('contracts-content')!;
const rawContractId = window.location.pathname.replace(/^\/contracts\/?/, '').replace(/\/$/, '');
let contractId: string;
try {
  contractId = decodeURIComponent(rawContractId);
} catch {
  // A malformed escape (/contracts/50%) throws here. Falling back to the raw
  // segment lets the not-found path render instead of pinning the skeleton.
  contractId = rawContractId;
}

function errorHtml(message: string) {
  return `<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 m-0">Contracts could not be loaded</h1>
    <p class="text-sm text-gray-600 mt-2">${escapeHtml(message)}</p>
    <p class="text-sm mt-4"><a href="/" class="text-plum-700">Back to the hub</a></p>
  </div>`;
}

function notFoundHtml() {
  return `<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 m-0">Contract not found</h1>
    <p class="text-sm text-gray-600 mt-2">
      No record matches this address. It may have been renamed in the AI-use survey.
    </p>
    <p class="text-sm mt-4"><a href="/contracts" class="text-plum-700">&larr; All contracts</a></p>
  </div>`;
}

let data: any = null;
try {
  data = await fetchApi('/contracts');
} catch (err: any) {
  // fetchApi has already started a redirect to /login for an expired session;
  // rendering an error here flashes a broken screen before the browser navigates.
  // Every sibling page suppresses this the same way.
  if (!String(err?.message ?? '').startsWith('Unauthorized')) {
    container.innerHTML = errorHtml(err?.message ?? 'Unknown error.');
  }
}

if (data) {
  const contracts = data.contracts ?? [];
  const postureById = indexPostures(data.postures);
  const capturedAt = data.population?.captured_at ?? null;

  if (contractId) {
    // ── Detail view ──────────────────────────────────────────────────────
    const contract = contracts.find((c: any) => c.contract_id === contractId);
    if (!contract) {
      document.title = 'Contract not found · Skills Hub';
      container.innerHTML = notFoundHtml();
    } else {
      document.title = `${contract.project || contract.contract_id} · Contract Explorer`;
      container.innerHTML = renderContractDetail(contract, postureById, capturedAt);
    }
  } else {
    // ── Grid view ────────────────────────────────────────────────────────
    document.title = 'Contract Explorer · Skills Hub';

    let includeUnclassified = false;
    let posture = 'all';
    let portfolio = 'all';
    let query = '';

    // Short names, so an option reads as the same thing as the badge on the cards
    // below it. The full label stays on the detail page, where it is the heading
    // for that posture's guidance.
    const postureOptions = (data.postures ?? [])
      .map((p: any) => `<option value="${escapeHtml(p.id)}">${escapeHtml(postureShortName(p))}</option>`)
      .join('');
    const portfolioOptions = portfoliosOf(contracts)
      .map((p) => `<option value="${escapeHtml(p)}">${escapeHtml(p)}</option>`)
      .join('');

    const selectClass = 'text-xs px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-plum-300';

    container.innerHTML = `
      <div class="mb-6">
        <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 no-underline mb-5 transition-colors">&larr; Back to hub</a>
        <h1 class="text-2xl font-bold text-gray-900 m-0">Contract Explorer</h1>
        <p class="text-sm text-gray-500 mt-1 m-0">
          Whether AI may be used on a contract, and what follows from that.
        </p>
        ${describePopulationNotice(data.population)}
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="relative flex-1 min-w-48">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none" aria-hidden="true">🔍</span>
          <input type="search" id="contracts-search" placeholder="Search…" autocomplete="off"
            class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-plum-300 focus:border-plum-400 placeholder:text-gray-600" />
        </div>
        <select id="contracts-portfolio" aria-label="Filter by portfolio" class="${selectClass}">
          <option value="all">All portfolios</option>${portfolioOptions}
        </select>
        <select id="contracts-posture" aria-label="Filter by AI posture" class="${selectClass}">
          <option value="all">All AI postures</option>${postureOptions}
        </select>
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <div id="contracts-unclassified"></div>
        <p class="text-xs text-gray-400 m-0" id="contracts-count"></p>
      </div>

      <div id="contracts-grid"></div>`;

    const gridEl = document.getElementById('contracts-grid')!;
    const countEl = document.getElementById('contracts-count')!;
    const toggleWrap = document.getElementById('contracts-unclassified')!;

    function render() {
      const visible = filterContracts(contracts, { posture, portfolio, query, includeUnclassified });
      const hidden = countHiddenUnclassified(contracts, { portfolio, query });

      toggleWrap.innerHTML = renderUnclassifiedToggle(hidden, includeUnclassified, posture !== 'all');
      countEl.textContent = `${visible.length} of ${contracts.length} record${contracts.length === 1 ? '' : 's'}`;
      gridEl.innerHTML = renderContractGrid(visible, postureById);

      document.getElementById('contracts-unclassified-toggle')?.addEventListener('click', () => {
        includeUnclassified = !includeUnclassified;
        render();
      });
    }

    render();

    document.getElementById('contracts-search')!.addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value;
      render();
    });
    document.getElementById('contracts-posture')!.addEventListener('change', (e) => {
      posture = (e.target as HTMLSelectElement).value;
      render();
    });
    document.getElementById('contracts-portfolio')!.addEventListener('change', (e) => {
      portfolio = (e.target as HTMLSelectElement).value;
      render();
    });
  }
}
</script>
