---
import '../styles/main.css';
const loginUrl = import.meta.env.PUBLIC_LOGIN_URL || '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Nava Skills Registry</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-50 min-h-screen flex items-center justify-center">

    <div class="w-full max-w-sm mx-auto px-4">
      <div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm">

        <!-- Logo -->
        <div class="flex items-center gap-2 mb-8">
          <span class="text-plum-600 font-bold text-lg leading-none">✦</span>
          <span class="font-semibold text-sm text-gray-900">Nava Skills Registry</span>
        </div>

        <h1 class="text-xl font-bold text-gray-900 mb-1">Sign in to continue</h1>
        <p class="text-sm text-gray-500 mb-6">
          Restricted to <strong class="font-medium text-gray-700">@navapbc.com</strong> accounts.
        </p>

        {!loginUrl && import.meta.env.DEV && (
          <p class="text-xs text-red-600 mb-4 p-2 bg-red-50 border border-red-200 rounded">
            PUBLIC_LOGIN_URL is not set. Add it to your .env file.
          </p>
        )}

        <a
          href={loginUrl || '#'}
          class="flex items-center justify-center gap-3 w-full px-4 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 no-underline transition-colors shadow-sm"
          aria-disabled={!loginUrl}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Sign in with Google
        </a>

        <p class="text-xs text-gray-600 mt-6 text-center">
          Problems signing in? Reach out in
          <a href="https://navapbc.slack.com/archives/C04PGR4K16D" target="_blank" class="text-plum-600 hover:text-plum-700 no-underline">#ai</a>.
        </p>
      </div>
    </div>

    <script>
      const btn = document.querySelector('a[href]') as HTMLAnchorElement;
      if (btn) {
        const returnTo = new URLSearchParams(window.location.search).get('return_to');
        if (returnTo) {
          const url = new URL(btn.href, window.location.origin);
          url.searchParams.set('return_to', returnTo);
          btn.href = url.toString();
        }
      }
    </script>
  </body>
</html>
