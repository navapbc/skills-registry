---
import Base from '../layouts/Base.astro';
import PluginCard from '../components/PluginCard.astro';
import SkillCard from '../components/SkillCard.astro';
import registryData from '../../public/registry/index.json';

const { plugins, skills } = registryData;
const allSkills = skills.filter(s => s.type === 'skill');
const allAgents = skills.filter(s => s.type === 'agent');
---

<Base title="Skills Marketplace">

  <!-- Page header -->
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 m-0">Skills Marketplace</h1>
      <p class="text-sm text-gray-500 mt-1 m-0">Browse, install, and share reusable AI skills across Nava</p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSdW3RSdwVvbFDFz_OBdZ1CzyNq_pYq_z8zsR0NdOknRApcR6A/viewform?usp=preview"
        target="_blank"
        rel="noopener"
        class="px-3 py-1.5 text-sm font-medium bg-plum-600 text-white rounded hover:bg-plum-700 no-underline transition-colors"
      >
        + Submit Skill
      </a>
    </div>
  </div>

  <!-- Plugins -->
  <section class="mb-10">
    <h2 class="text-base font-semibold text-gray-700 mb-3">Plugins</h2>
    <div class="grid grid-cols-3 gap-3">
      {plugins.map(plugin => (
        <PluginCard plugin={plugin} />
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="mb-10">
    <h2 class="text-base font-semibold text-gray-700 mb-3">Skills</h2>

    <!-- Toolbar -->
    <div class="flex items-center gap-3 mb-3">
      <div class="relative flex-1 max-w-xs">
        <input
          type="search"
          id="skill-search"
          placeholder="Search skills..."
          autocomplete="off"
          class="w-full pl-3 pr-3 py-1.5 text-sm border border-gray-200 rounded bg-white focus:outline-none focus:ring-2 focus:ring-plum-300 focus:border-plum-400 placeholder:text-gray-400"
        />
      </div>
      <select
        id="skill-sort"
        class="px-2 py-1.5 text-sm border border-gray-200 rounded bg-white focus:outline-none focus:ring-2 focus:ring-plum-300 cursor-pointer text-gray-700"
      >
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
        <option value="az">A–Z</option>
      </select>
    </div>

    <!-- Filter tags -->
    <div class="flex items-center gap-1.5 flex-wrap mb-4" id="filter-tags">
      <button class="px-2.5 py-1 text-xs font-medium rounded-full bg-plum-600 text-white border border-plum-600 cursor-pointer transition-colors" data-filter="all">all</button>
      <button class="px-2.5 py-1 text-xs font-medium rounded-full bg-white text-gray-600 border border-gray-200 cursor-pointer hover:border-gray-300 transition-colors" data-filter="claude-code">claude-code</button>
      <button class="px-2.5 py-1 text-xs font-medium rounded-full bg-white text-gray-600 border border-gray-200 cursor-pointer hover:border-gray-300 transition-colors" data-filter="claude-chat">claude-chat</button>
      <button class="px-2.5 py-1 text-xs font-medium rounded-full bg-white text-gray-600 border border-gray-200 cursor-pointer hover:border-gray-300 transition-colors" data-filter="claude-cowork">claude-cowork</button>
      <button class="px-2.5 py-1 text-xs font-medium rounded-full bg-white text-gray-600 border border-gray-200 cursor-pointer hover:border-gray-300 transition-colors" data-filter="sensitive">⚠ sensitive</button>
    </div>

    <div class="grid grid-cols-3 gap-3" id="skills-grid">
      {allSkills.map(skill => (
        <SkillCard skill={skill} />
      ))}
    </div>
  </section>

  {allAgents.length > 0 && (
    <section class="mb-10">
      <h2 class="text-base font-semibold text-gray-700 mb-3">Agents</h2>
      <div class="grid grid-cols-3 gap-3">
        {allAgents.map(agent => (
          <SkillCard skill={agent} />
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  const searchInput = document.getElementById('skill-search') as HTMLInputElement;
  const sortSelect = document.getElementById('skill-sort') as HTMLSelectElement;
  const filterTagsEl = document.getElementById('filter-tags');
  const grid = document.getElementById('skills-grid');

  if (!grid) throw new Error('skills-grid not found');

  const cards = Array.from(grid.querySelectorAll('a')) as HTMLElement[];
  let activeFilter = 'all';

  function applyFilters() {
    const query = searchInput?.value.toLowerCase() || '';
    cards.forEach(card => {
      const name = card.dataset.name?.toLowerCase() || '';
      const description = card.dataset.description?.toLowerCase() || '';
      const compatibility = card.dataset.compatibility || '';
      const sensitive = card.dataset.sensitive === 'true';

      const matchesSearch = !query || name.includes(query) || description.includes(query);
      const matchesFilter =
        activeFilter === 'all' ||
        (activeFilter === 'sensitive' ? sensitive : compatibility.includes(activeFilter));

      card.style.display = matchesSearch && matchesFilter ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', applyFilters);

  filterTagsEl?.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-filter]') as HTMLElement;
    if (!btn) return;
    activeFilter = btn.dataset.filter || 'all';
    filterTagsEl.querySelectorAll('button').forEach(b => {
      b.className = 'px-2.5 py-1 text-xs font-medium rounded-full bg-white text-gray-600 border border-gray-200 cursor-pointer hover:border-gray-300 transition-colors';
    });
    btn.className = 'px-2.5 py-1 text-xs font-medium rounded-full bg-plum-600 text-white border border-plum-600 cursor-pointer transition-colors';
    applyFilters();
  });

  sortSelect?.addEventListener('change', () => {
    const value = sortSelect.value;
    const sorted = [...cards].sort((a, b) => {
      if (value === 'az') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      if (value === 'oldest') return (a.dataset.updated || '').localeCompare(b.dataset.updated || '');
      // newest: reverse chronological
      return (b.dataset.updated || '').localeCompare(a.dataset.updated || '');
    });
    sorted.forEach(c => grid.appendChild(c));
  });
</script>
