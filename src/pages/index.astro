---
import Base from '../layouts/Base.astro';
import Tooltip from '../components/Tooltip.astro';
---

<Base title="Skills Marketplace" description="Browse, install, and share reusable AI skills and agents across Nava.">

  <!-- Page title -->
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 m-0">Skills Marketplace</h1>
    <p class="text-sm text-gray-500 mt-1 m-0">Browse, install, and share reusable AI skills across Nava</p>
  </div>

  <!-- Favorites — shown only if user has favorites (populated by client script) -->
  <div id="favorites-section" class="hidden mb-6">
    <h2 class="text-base font-semibold text-gray-700 m-0 mb-3">Your Favorites</h2>
    <div id="favorites-grid"></div>
  </div>

  <!-- CATEGORIES SECTION — commented out, revisit later
  <div class="mb-3">
    <h2 class="text-base font-semibold text-gray-700 m-0">Categories</h2>
  </div>
  <div id="category-grid"></div>
  END CATEGORIES SECTION -->

  <!-- New this week strip — populated by client script after skills are fetched -->
  <div class="mt-8 mb-3">
    <h2 class="text-base font-semibold text-gray-700 m-0">New This Week</h2>
  </div>
  <div id="new-this-week">
    <div class="bg-white border border-gray-200 rounded-lg p-4 mb-10 animate-pulse">
      <div class="flex items-center justify-between mb-3">
        <div class="h-3 bg-gray-100 rounded w-20"></div>
      </div>
      <div class="flex gap-3">
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 flex-1"><div class="h-3 bg-gray-200 rounded w-3/4 mb-1.5"></div><div class="h-3 bg-gray-100 rounded w-1/2"></div></div>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 flex-1"><div class="h-3 bg-gray-200 rounded w-2/3 mb-1.5"></div><div class="h-3 bg-gray-100 rounded w-2/5"></div></div>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 flex-1"><div class="h-3 bg-gray-200 rounded w-3/4 mb-1.5"></div><div class="h-3 bg-gray-100 rounded w-1/2"></div></div>
      </div>
    </div>
  </div>

  <!-- Search -->
  <div class="mt-8 mb-8">
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none" aria-hidden="true">🔍</span>
      <input
        type="search"
        id="global-search"
        placeholder="Search skills, agents, and plugins..."
        autocomplete="off"
        aria-label="Search skills, agents, and plugins"
        class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 rounded-lg bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-plum-300 focus:border-plum-400 placeholder:text-gray-400"
      />
    </div>
  </div>

  <!-- Browse view -->
  <div id="browse-view">

    <!-- Plugins -->
    <!-- Skills -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-1.5">
          <h2 class="text-base font-semibold text-gray-700 m-0">Skills</h2>
          <span class="text-xs text-gray-400" id="skills-count"></span>
          <Tooltip text='A Skill is a reusable prompt workflow (SKILL.md) that guides an AI through a specific task — like "debug", "write tests", or "plan implementation". You invoke it deliberately.' width="w-64" />
        </div>
        <a id="skills-expand" href="/skills" class="text-xs text-plum-600 hover:text-plum-700 no-underline hidden">
          View all →
        </a>
      </div>
      <div id="skills-grid">
        <div class="grid grid-cols-3 gap-3 animate-pulse">
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div><div class="h-3 bg-gray-100 rounded w-full mb-1"></div><div class="h-3 bg-gray-100 rounded w-4/5"></div></div>
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-2/3 mb-2"></div><div class="h-3 bg-gray-100 rounded w-full mb-1"></div><div class="h-3 bg-gray-100 rounded w-3/5"></div></div>
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div><div class="h-3 bg-gray-100 rounded w-5/6 mb-1"></div><div class="h-3 bg-gray-100 rounded w-4/5"></div></div>
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-1/2 mb-2"></div><div class="h-3 bg-gray-100 rounded w-full mb-1"></div><div class="h-3 bg-gray-100 rounded w-2/3"></div></div>
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div><div class="h-3 bg-gray-100 rounded w-4/5 mb-1"></div><div class="h-3 bg-gray-100 rounded w-3/4"></div></div>
          <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"><div class="h-4 bg-gray-200 rounded w-2/3 mb-2"></div><div class="h-3 bg-gray-100 rounded w-full mb-1"></div><div class="h-3 bg-gray-100 rounded w-1/2"></div></div>
        </div>
      </div>
    </section>

    <!-- Agents -->
    <section class="mb-10" id="agents-section" style="display:none">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-1.5">
          <h2 class="text-base font-semibold text-gray-700 m-0">Agents</h2>
          <span class="text-xs text-gray-400" id="agents-count"></span>
          <Tooltip text="An Agent is a project-level AI config file (CLAUDE.md, .cursorrules, copilot-instructions.md) that sets baseline behavior across a whole project — more like a system prompt than a task." width="w-64" />
        </div>
        <a id="agents-expand" href="/agents" class="text-xs text-plum-600 hover:text-plum-700 no-underline hidden">
          View all →
        </a>
      </div>
      <div id="agents-grid"></div>
    </section>

    <!-- PLUGINS SECTION — commented out, revisit later
    <section class="mb-10">
      <div class="flex items-center gap-1.5 mb-3">
        <h2 class="text-base font-semibold text-gray-700 m-0">Plugins</h2>
        <span class="text-xs text-gray-400" id="plugins-count"></span>
      </div>
      <div id="plugins-list"></div>
    </section>
    END PLUGINS SECTION -->

    <!-- MCP Servers placeholder -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-3">
        <h2 class="text-base font-semibold text-gray-700 m-0">MCP Servers</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-50 text-amber-600 rounded-full border border-amber-200">Coming soon</span>
        <Tooltip text="Model Context Protocol servers expose tools, resources, and prompts to AI assistants. Registry support for MCP servers is coming soon." width="w-64" />
      </div>
      <div class="p-6 bg-white border border-gray-200 border-dashed rounded-lg text-center">
        <p class="text-sm text-gray-400 m-0">MCP server discovery will appear here once registry support is added.</p>
        <a href="/contribute" class="inline-block mt-3 text-xs text-plum-600 hover:text-plum-700 no-underline">Learn how to contribute →</a>
      </div>
    </section>

  </div>

  <!-- Search results -->
  <div id="search-results" class="hidden" role="region" aria-label="Search results" aria-live="polite">
    <p class="text-xs text-gray-400 mb-4" id="search-summary"></p>
    <div id="results-list" class="space-y-1"></div>
    <p class="text-sm text-gray-400 italic hidden" id="no-results">No results found.</p>
  </div>

</Base>

<script>
import { fetchApi } from '../lib/api.mjs';
import { renderSkillCard, escapeHtml, renderCategoryGrid, renderNewThisWeek } from '../lib/render.mjs';
import { CATEGORIES } from '../lib/categories.mjs';
import { getFavorites } from '../lib/favorites.mjs';

const PREVIEW_COUNT = 6;

// Render favorites immediately from localStorage (no API needed)
const favs = getFavorites();
if (favs.length > 0) {
  document.getElementById('favorites-section').classList.remove('hidden');
  document.getElementById('favorites-grid').innerHTML = `<div class="grid grid-cols-3 gap-3">
    ${favs.map(f => `<div class="h-full"><a href="/${f.type === 'agent' ? 'agents' : 'skills'}/${escapeHtml(f.slug)}" class="h-full flex flex-col gap-3 p-4 bg-white border border-amber-200 rounded-lg hover:shadow-md hover:border-amber-300 transition-all no-underline text-gray-900">
      <div class="flex items-start justify-between gap-2">
        <span class="font-semibold text-sm text-gray-900">${escapeHtml(f.name)}</span>
        <span class="text-amber-500 text-sm flex-shrink-0" aria-hidden="true">★</span>
      </div>
      <p class="text-xs text-gray-500 leading-relaxed m-0 flex-1">${escapeHtml(f.description ? (f.description.length > 110 ? f.description.slice(0, 110) + '...' : f.description) : '')}</p>
      <span class="text-xs text-gray-400">${escapeHtml(f.plugin || '')}</span>
    </a></div>`).join('')}
  </div>`;
}

const globalSearch = document.getElementById('global-search');
const browseView = document.getElementById('browse-view');
const searchResults = document.getElementById('search-results');
const resultsList = document.getElementById('results-list');
const searchSummary = document.getElementById('search-summary');
const noResults = document.getElementById('no-results');

const TYPE_STYLES = {
  plugin: 'bg-plum-50 text-plum-700',
  skill:  'bg-gray-100 text-gray-600',
  agent:  'bg-blue-50 text-blue-700',
};

let searchIndex = [];

// Fetch admin-managed category config first, then merge with static CATEGORIES
fetchApi('/categories').then(({ categories: apiCategories }) => {
  const mergedCategories = CATEGORIES.map(c => {
    const override = apiCategories.find(x => x.id === c.id);
    return { ...c, featuredSlugs: override?.featuredSlugs ?? [] };
  });

  const categorySlugs = [...new Set(
    mergedCategories.flatMap(c => [...(c.featuredSlugs || []), ...(c.slugs || [])])
  )].join(',');

  return Promise.all([
    fetchApi('/skills?slugs=' + encodeURIComponent(categorySlugs)),
    fetchApi('/skills'),
    fetchApi('/plugins'),
    Promise.resolve(mergedCategories),
  ]);
}).then(([{ skills: catSkills }, { skills }, { plugins }, mergedCategories]) => {
  // Category grid: merge targeted fetch with full list so enterprise skills (source=enterprise)
  // are included even if their slugs aren't in the static categories.mjs config
  const enterpriseSkills = skills.filter(s => s.source === 'enterprise');
  const catSkillSlugs = new Set(catSkills.map(s => s.slug));
  const gridSkills = [...catSkills, ...enterpriseSkills.filter(s => !catSkillSlugs.has(s.slug))];
  // category-grid hidden — see HTML comment above
  document.getElementById('new-this-week').innerHTML = renderNewThisWeek(skills, mergedCategories);

  // Enterprise (org-wide) skills surfaced first in the skills grid
  const allSkills = skills
    .filter(s => s.type === 'skill')
    .sort((a, b) => {
      if (a.source === 'enterprise' && b.source !== 'enterprise') return -1;
      if (b.source === 'enterprise' && a.source !== 'enterprise') return 1;
      return 0;
    });
  const allAgents = skills.filter(s => s.type === 'agent');

  // Plugins — section hidden, guard against missing DOM elements
  const sortedPlugins = [...plugins].sort((a, b) => {
    const aTotal = (a.skills_count || 0) + (a.agents_count || 0);
    const bTotal = (b.skills_count || 0) + (b.agents_count || 0);
    return bTotal - aTotal;
  });
  // Plugins section hidden — elements may not exist in DOM
  // Uncomment HTML section above to re-enable
  /*
  document.getElementById('plugins-count').textContent = `(${plugins.length})`;
  document.getElementById('plugins-list').innerHTML = `<div class="grid grid-cols-4 gap-2">
    ${sortedPlugins.map(p => {
      const skills = p.skills_count || 0;
      const agents = p.agents_count || 0;
      const total = skills + agents;
      return `<a href="/plugins/${escapeHtml(p.slug)}" class="flex items-center justify-between px-3 py-2 bg-white border border-gray-200 rounded-lg hover:border-plum-300 hover:shadow-sm no-underline transition-all group">
        <span class="text-sm font-medium text-gray-800 group-hover:text-plum-700 truncate transition-colors">${escapeHtml(p.name)}</span>
        <span class="text-xs text-gray-400 ml-2 flex-shrink-0 tabular-nums">${total}</span>
      </a>`;
    }).join('')}
  </div>`;
  */

  // Skills grid
  document.getElementById('skills-count').textContent = `(${allSkills.length})`;
  renderGrid('skills-grid', 'skills-expand', allSkills);

  // Agents grid
  if (allAgents.length) {
    document.getElementById('agents-section').style.display = '';
    document.getElementById('agents-count').textContent = `(${allAgents.length})`;
    renderGrid('agents-grid', 'agents-expand', allAgents);
  }

  // Build search index
  searchIndex = [
    ...plugins.map(p => ({
      type: 'plugin',
      name: p.name,
      description: p.description || '',
      url: `/plugins/${p.slug}`,
      meta: `${p.skills_count || 0} skills`,
      keywords: '',
    })),
    ...allSkills.map(s => ({
      type: 'skill',
      name: s.name,
      description: s.description || '',
      url: `/skills/${s.slug}`,
      meta: s.plugin,
      keywords: [s.plugin, ...(s.compatibility || [])].join(' '),
    })),
    ...allAgents.map(s => ({
      type: 'agent',
      name: s.name,
      description: s.description || '',
      url: `/skills/${s.slug}`,
      meta: s.plugin,
      keywords: [s.plugin, ...(s.compatibility || [])].join(' '),
    })),
  ];

  initGithubLinks();
}).catch(err => {
  if (!err.message.startsWith('Unauthorized')) {
    document.getElementById('skills-grid').innerHTML = '<p class="text-sm text-gray-500">Failed to load skills. Please refresh the page.</p>';
  }
});

function renderGrid(gridId, expandBtnId, items) {
  const grid = document.getElementById(gridId);
  const expandLink = document.getElementById(expandBtnId);

  grid.innerHTML = `<div class="grid grid-cols-3 gap-3">
    ${items.slice(0, PREVIEW_COUNT).map(skill => `<div>${renderSkillCard(skill)}</div>`).join('')}
  </div>`;

  if (items.length > PREVIEW_COUNT) {
    expandLink.classList.remove('hidden');
    expandLink.textContent = `View all (${items.length}) →`;
  }
}

function initGithubLinks() {
  document.querySelectorAll('[data-github-url]').forEach(el => {
    el.addEventListener('click', e => {
      const url = el.dataset.githubUrl;
      if (url) { e.preventDefault(); e.stopPropagation(); window.open(url, '_blank', 'noopener'); }
    });
  });
}

// Search
function renderResults(query) {
  const q = query.toLowerCase().trim();
  if (!q) {
    browseView.classList.remove('hidden');
    searchResults.classList.add('hidden');
    return;
  }
  browseView.classList.add('hidden');
  searchResults.classList.remove('hidden');

  const matches = searchIndex.filter(item =>
    item.name.toLowerCase().includes(q) ||
    item.description.toLowerCase().includes(q) ||
    item.meta.toLowerCase().includes(q) ||
    item.keywords.toLowerCase().includes(q)
  );

  searchSummary.textContent = `${matches.length} result${matches.length !== 1 ? 's' : ''} for "${query}"`;
  noResults.classList.toggle('hidden', matches.length > 0);

  resultsList.innerHTML = matches.map(item => `
    <a href="${escapeHtml(item.url)}" class="flex items-start gap-3 px-4 py-3 bg-white border border-gray-200 rounded-lg hover:border-plum-300 hover:shadow-sm no-underline transition-all group">
      <span class="mt-0.5 px-1.5 py-0.5 text-xs font-medium rounded flex-shrink-0 ${TYPE_STYLES[item.type] || 'bg-gray-100 text-gray-600'}">${escapeHtml(item.type)}</span>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-gray-900 m-0 group-hover:text-plum-700 transition-colors">${escapeHtml(item.name)}</p>
        ${item.description ? `<p class="text-xs text-gray-500 m-0 mt-0.5 truncate">${escapeHtml(item.description)}</p>` : ''}
      </div>
      <span class="ml-auto text-xs text-gray-400 flex-shrink-0 mt-0.5">${escapeHtml(item.meta)}</span>
    </a>
  `).join('');
}

globalSearch?.addEventListener('input', e => renderResults(e.target.value));
</script>
