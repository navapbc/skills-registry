---
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import registryData from '../../../public/registry/index.json';

export function getStaticPaths() {
  return registryData.plugins.map(plugin => ({
    params: { slug: plugin.slug },
    props: { plugin },
  }));
}

const { plugin } = Astro.props;
const pluginSkills = registryData.skills.filter(s => plugin.skills.includes(s.slug));
const pluginAgents = registryData.skills.filter(
  s => s.type === 'agent' && plugin.agents?.includes(s.slug)
);
const initial = plugin.author.slice(0, 1).toUpperCase();
---

<Base title={plugin.name}>

  <!-- Back -->
  <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 no-underline mb-5 transition-colors">
    ← Back to Marketplace
  </a>

  <!-- Plugin header -->
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-gray-900 m-0">{plugin.name}</h1>
      {plugin.description && (
        <p class="text-sm text-gray-500 mt-1 m-0">{plugin.description}</p>
      )}
      <a
        href={`https://github.com/${plugin.repo}`}
        target="_blank"
        rel="noopener"
        class="inline-block mt-1 text-xs text-plum-600 hover:text-plum-700 no-underline"
      >
        /{plugin.name} ↗
      </a>
    </div>
    <span
      class="w-9 h-9 rounded-full bg-plum-100 text-plum-700 text-sm font-semibold flex items-center justify-center flex-shrink-0"
      aria-label={plugin.author}
    >
      {initial}
    </span>
  </div>

  <!-- Tabs -->
  <div class="flex items-center gap-0 border-b border-gray-200 mb-6">
    <button class="px-4 py-2 text-sm font-medium text-plum-700 border-b-2 border-plum-600 -mb-px bg-transparent cursor-pointer" data-tab="skills">
      Skills ({plugin.skill_count})
    </button>
    {pluginAgents.length > 0 && (
      <button class="px-4 py-2 text-sm font-medium text-gray-500 border-b-2 border-transparent -mb-px bg-transparent cursor-pointer hover:text-gray-700" data-tab="agents">
        Agents ({plugin.agent_count})
      </button>
    )}
    <button class="px-4 py-2 text-sm font-medium text-gray-500 border-b-2 border-transparent -mb-px bg-transparent cursor-pointer hover:text-gray-700" data-tab="history">
      History
    </button>
  </div>

  <!-- Skills tab -->
  <div id="tab-skills">
    <p class="text-sm text-gray-500 mb-4">Skills ({plugin.skill_count})</p>
    <div class="grid grid-cols-3 gap-3">
      {pluginSkills.map(skill => (
        <SkillCard skill={skill} showPlugin={false} />
      ))}
    </div>
  </div>

  <!-- Agents tab -->
  {pluginAgents.length > 0 && (
    <div id="tab-agents" class="hidden">
      <p class="text-sm text-gray-500 mb-4">Agents ({plugin.agent_count})</p>
      <div class="grid grid-cols-3 gap-3">
        {pluginAgents.map(agent => (
          <SkillCard skill={agent} showPlugin={false} />
        ))}
      </div>
    </div>
  )}

  <!-- History tab -->
  <div id="tab-history" class="hidden">
    <p class="text-sm text-gray-400 italic">Skill history will appear here once the registry tracks version changes.</p>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll('[data-tab]');
  const activeClass = ['text-plum-700', 'border-plum-600'];
  const inactiveClass = ['text-gray-500', 'border-transparent'];

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;

      tabs.forEach(t => {
        t.classList.remove(...activeClass);
        t.classList.add(...inactiveClass);
      });
      tab.classList.add(...activeClass);
      tab.classList.remove(...inactiveClass);

      ['skills', 'agents', 'history'].forEach(name => {
        const panel = document.getElementById(`tab-${name}`);
        if (panel) panel.classList.toggle('hidden', name !== target);
      });
    });
  });
</script>
