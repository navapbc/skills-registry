---
import Base from '../../layouts/Base.astro';

// One page serves both /initiatives and /initiatives/<id>, branching on the
// pathname — the same shape as src/pages/contracts/index.astro and
// src/pages/skills/index.astro. Two pages would duplicate the fetch, the loading
// state, and the not-found rendering.
//
// The detail path only resolves because functions/edge/auth-check.js.tpl rewrites
// /initiatives/* to this shell. Without that entry the grid works and every detail
// URL serves the 404 page.
---
<Base title="Initiatives Hub" description="AI initiatives across Nava, and the projects they run on.">
  <div id="initiatives-content">
    <div class="animate-pulse">
      <div class="h-4 bg-gray-100 rounded w-28 mb-5"></div>
      <div class="h-8 bg-gray-200 rounded w-2/3 mb-2"></div>
      <div class="h-4 bg-gray-100 rounded w-1/3 mb-6"></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
        <div class="bg-white border border-gray-200 rounded-lg p-4 h-32"></div>
      </div>
    </div>
  </div>
</Base>

<script>
import { fetchApi } from '../../lib/api.mjs';
import { escapeHtml } from '../../lib/render.mjs';
import {
  filterInitiatives,
  useCasesOf,
  exposuresOf,
  describePopulationNotice,
  initiativesApiPath,
  renderInitiativeGrid,
  renderInitiativeDetail,
} from '../../lib/initiatives-render.mjs';

const container = document.getElementById('initiatives-content')!;
const rawId = window.location.pathname.replace(/^\/initiatives\/?/, '').replace(/\/$/, '');
let initiativeId: string;
try {
  initiativeId = decodeURIComponent(rawId);
} catch {
  // A malformed escape (/initiatives/50%) throws here. Falling back to the raw
  // segment lets the not-found path render instead of pinning the skeleton.
  initiativeId = rawId;
}

function errorHtml(message: string) {
  return `<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 m-0">Initiatives could not be loaded</h1>
    <p class="text-sm text-gray-600 mt-2">${escapeHtml(message)}</p>
    <p class="text-sm mt-4"><a href="/" class="text-plum-700">Back to the hub</a></p>
  </div>`;
}

// Addresses now come from the sheet's own `id` column, so a retitle no longer moves
// one — the explanation this used to give became wrong when the key changed. Two
// causes remain: the record was removed, or the link predates the move off
// title-derived addresses, which changed every URL once.
function notFoundHtml() {
  return `<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 m-0">Initiative not found</h1>
    <p class="text-sm text-gray-600 mt-2">
      No record matches this address. Either the initiative was removed from the
      initiatives sheet, or this is an older link — addresses used to be built from the
      initiative's title and now come from the sheet's own id, so links made before that
      change no longer resolve.
    </p>
    <p class="text-sm mt-4"><a href="/initiatives" class="text-plum-700">&larr; All initiatives</a></p>
  </div>`;
}

// The detail view asks for the project→contracts join; the grid does not, and the
// API skips reading the contracts table entirely without the parameter. An id
// matching nothing is not an error — the response is the plain list and the
// not-found branch below renders.
let data: any = null;
try {
  data = await fetchApi(initiativesApiPath(initiativeId));
} catch (err: any) {
  // fetchApi has already started a redirect to /login for an expired session;
  // rendering an error here flashes a broken screen before the browser navigates.
  // Every sibling page suppresses this the same way.
  if (!String(err?.message ?? '').startsWith('Unauthorized')) {
    container.innerHTML = errorHtml(err?.message ?? 'Unknown error.');
  }
}

if (data) {
  const initiatives = data.initiatives ?? [];
  const capturedAt = data.population?.captured_at ?? null;

  if (initiativeId) {
    // ── Detail view ──────────────────────────────────────────────────────
    const initiative = initiatives.find((i: any) => i.initiative_id === initiativeId);
    if (!initiative) {
      document.title = 'Initiative not found · Skills Hub';
      container.innerHTML = notFoundHtml();
    } else {
      document.title = `${initiative.title || initiative.initiative_id} · Initiatives Hub`;
      container.innerHTML = renderInitiativeDetail(initiative, capturedAt);
    }
  } else {
    // ── Grid view ────────────────────────────────────────────────────────
    document.title = 'Initiatives Hub · Skills Hub';

    let useCase = 'all';
    let exposure = 'all';
    let query = '';

    // Options come from the data, not from hardcoded lists, so a new use case or
    // exposure value in the sheet appears in the filter without a deploy.
    const optionsFor = (values: string[]) => values
      .map((v) => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`)
      .join('');

    const selectClass = 'text-xs px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-plum-300';

    container.innerHTML = `
      <div class="mb-6">
        <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 no-underline mb-5 transition-colors">&larr; Back to hub</a>
        <h1 class="text-2xl font-bold text-gray-900 m-0">Initiatives Hub</h1>
        <p class="text-sm text-gray-500 mt-1 m-0">
          Examples of AI in use at Nava.
        </p>
        ${describePopulationNotice(data.population)}
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="relative flex-1 min-w-48">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none" aria-hidden="true">🔍</span>
          <input type="search" id="initiatives-search" placeholder="Search…" autocomplete="off"
            class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-plum-300 focus:border-plum-400 placeholder:text-gray-600" />
        </div>
        <select id="initiatives-use-case" aria-label="Filter by use case" class="${selectClass}">
          <option value="all">All use cases</option>${optionsFor(useCasesOf(initiatives))}
        </select>
        <select id="initiatives-exposure" aria-label="Filter by exposure" class="${selectClass}">
          <option value="all">All exposures</option>${optionsFor(exposuresOf(initiatives))}
        </select>
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <p class="text-xs text-gray-400 m-0" id="initiatives-count"></p>
      </div>

      <div id="initiatives-grid"></div>`;

    const gridEl = document.getElementById('initiatives-grid')!;
    const countEl = document.getElementById('initiatives-count')!;

    function render() {
      const visible = filterInitiatives(initiatives, { useCase, exposure, query });
      countEl.textContent = `${visible.length} of ${initiatives.length} initiative${initiatives.length === 1 ? '' : 's'}`;
      gridEl.innerHTML = renderInitiativeGrid(visible);
    }

    render();

    document.getElementById('initiatives-search')!.addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value;
      render();
    });
    document.getElementById('initiatives-use-case')!.addEventListener('change', (e) => {
      useCase = (e.target as HTMLSelectElement).value;
      render();
    });
    document.getElementById('initiatives-exposure')!.addEventListener('change', (e) => {
      exposure = (e.target as HTMLSelectElement).value;
      render();
    });
  }
}
</script>
