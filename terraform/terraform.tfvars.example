# Copy to terraform.staging.tfvars or terraform.prod.tfvars and fill in values.
# Never commit files with real secrets to git.

# --- Environment identity ---
environment  = "staging"   # or "prod"
project_name = "skills-registry"
aws_region   = "us-east-1"

# --- Custom domain (optional) ---
# staging: skills-staging.navapbc.com
# prod:    skills.navapbc.com
# Leave empty to use the auto-assigned CloudFront domain.
site_domain         = ""
acm_certificate_arn = ""   # ACM cert must be in us-east-1 for CloudFront

# --- Google OAuth (from Google Cloud Console > APIs & Services > Credentials) ---
google_client_id     = "REPLACE_WITH_GOOGLE_CLIENT_ID"
google_client_secret = "REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# --- JWT signing secret (generate with: openssl rand -hex 32) ---
jwt_secret = "REPLACE_WITH_32_CHAR_SECRET"

# --- GitHub OIDC trust ---
github_org  = "navapbc"
github_repo = "skills-registry"

# Keep this false. The GitHub OIDC provider is account-global (one per account),
# shared by both staging and prod, and managed manually out-of-band — not by
# Terraform. Do NOT set true: it fails if the provider exists, and any later
# flip back destroys it for both environments, breaking all OIDC deploys.
# To let Terraform manage it, `terraform import` it instead. See iam.tf.
create_oidc_provider = false

# Own the account-global github-automated-deploys IAM group in this env's state.
# Exactly ONE environment may set this true (staging owns it by convention);
# every other env keeps it false. See iam.tf / variables.tf.
manage_shared_iam = false

# --- Access control ---
allowed_email_domain = "navapbc.com"

# --- Site URL (breaks Lambda <-> CloudFront circular dependency) ---
site_url = "https://hub.navapbc.com"
