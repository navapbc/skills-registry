# Dependencies
node_modules/

# Build output
dist/
.astro/

# Test coverage
coverage/

# Environment variables
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform state (sensitive — use remote backend)
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform/
# .terraform.lock.hcl is committed on purpose: it pins provider versions +
# checksums so CI can't silently pull a new (possibly broken) release.
terraform/*.zip

# Inspiration screenshots (local only)
inspo/

# Brainstorm session files
.superpowers/

# Local bug tracking / scratch notes
bugs/

# Terraform secrets — never commit real tfvars
terraform/*.tfvars
!terraform/*.tfvars.example
